<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Hakari</AssemblyName>
    <!-- One collector thread instead of a concurrent background one: less memory, idle app -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hakari.Core\Hakari.Core.csproj" />
    <ProjectReference Include="..\Hakari.Taskbar\Hakari.Taskbar.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\data\pricing.json" Link="pricing.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
