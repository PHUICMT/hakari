<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hakari.Core.Tests" />
  </ItemGroup>

  <!-- One file per language; embedded so every executable has them without copying -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\locales\*.json"
      LogicalName="Hakari.Core.Locales.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
