<Window
    x:Class="Hakari.Surfaces.Flyout.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Hakari.Surfaces.Flyout"
    xmlns:l="using:Hakari.Surfaces.Localization"
    Title="Hakari">

    <Grid x:Name="Root" Background="{ThemeResource HakariSurfaceBrush}" Opacity="0"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootOffset" Y="0" />
        </Grid.RenderTransform>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="Body" Padding="16" Spacing="16">
            <!-- Header -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="秤" FontFamily="{StaticResource HakariBrandFont}" FontSize="20"
                    FontWeight="Bold" Foreground="{ThemeResource HakariAccentBrush}"
                    VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Hakari" FontWeight="SemiBold" Foreground="{ThemeResource HakariInkBrush}" />
                    <TextBlock x:Name="AccountText" Style="{StaticResource HakariCaptionText}" />
                </StackPanel>
                <TextBlock x:Name="UpdatedText" Grid.Column="2" Style="{StaticResource HakariCaptionText}"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- Notice (last known limits) -->
            <Border x:Name="NoticeCard" Visibility="Collapsed" Padding="10,8"
                CornerRadius="{StaticResource HakariControlRadius}"
                Background="{ThemeResource HakariTileBrush}" BorderBrush="{ThemeResource HakariLineBrush}"
                BorderThickness="1">
                <TextBlock x:Name="NoticeText" Style="{StaticResource HakariLabelText}" TextWrapping="Wrap"
                    TextTrimming="None" />
            </Border>

            <!-- Accounts: a card each, most pressing first; the header folds the card. On a
                 short screen this part scrolls, so the money and the buttons stay in view -->
            <ScrollViewer x:Name="AccountScroller" VerticalScrollMode="Auto"
                VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="AccountList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:AccountLimitGroup">
                        <Border Style="{StaticResource HakariCard}">
                            <StackPanel>
                                <Button Style="{StaticResource HakariCardHeaderButton}"
                                    Tag="{x:Bind AccountId}" Click="OnAccountHeaderClicked">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13"
                                                Foreground="{ThemeResource HakariInkBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource HakariCaptionText}"
                                                TextWrapping="Wrap" TextTrimming="None" />
                                        </StackPanel>
                                        <TextBlock x:Name="FoldedSummary" Grid.Column="1" Text="{x:Bind Summary}"
                                            Visibility="{x:Bind SummaryVisibility}"
                                            FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                            Foreground="{x:Bind local:FlyoutBrushes.ForTone(SummaryTone)}" />
                                        <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="11"
                                            FontFamily="{StaticResource HakariIconFont}"
                                            Foreground="{ThemeResource HakariInkMutedBrush}" RenderTransformOrigin="0.5,0.5">
                                            <FontIcon.RenderTransform>
                                                <RotateTransform Angle="{x:Bind ChevronAngle}" />
                                            </FontIcon.RenderTransform>
                                        </FontIcon>
                                    </Grid>
                                </Button>
                                <!-- Spacing sits on the panel: ItemsControl ignores Padding -->
                                <ItemsControl ItemsSource="{x:Bind Limits}"
                                    Visibility="{x:Bind LimitsVisibility}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="12" Margin="12,2,12,12" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:LimitRow">
                                            <StackPanel Spacing="6">
                                                <Grid>
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource HakariLabelText}" />
                                                    <TextBlock Text="{x:Bind Value}" HorizontalAlignment="Right"
                                                        Style="{StaticResource HakariValueText}"
                                                        Foreground="{x:Bind local:FlyoutBrushes.ForValue(Tone)}" />
                                                </Grid>
                                                <Grid>
                                                    <Border Height="6" CornerRadius="3" Background="{ThemeResource HakariLineBrush}">
                                                        <Border x:Name="MeterFill" CornerRadius="3" RenderTransformOrigin="0,0.5"
                                                            Background="{x:Bind local:FlyoutBrushes.ForTone(Tone)}"
                                                            Tag="{x:Bind Fraction}">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="{x:Bind Fraction}" ScaleY="1" />
                                                            </Border.RenderTransform>
                                                        </Border>
                                                    </Border>
                                                    <!-- Where an even pace through the week would be by now -->
                                                    <Grid Visibility="{x:Bind PaceVisibility}" IsHitTestVisible="False">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{x:Bind PaceBefore}" />
                                                            <ColumnDefinition Width="{x:Bind PaceAfter}" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="1" Width="2" Height="12" Margin="-1,-3,0,-3"
                                                            HorizontalAlignment="Left" CornerRadius="1"
                                                            Background="{ThemeResource HakariInkFaintBrush}" />
                                                    </Grid>
                                                </Grid>
                                                <Grid>
                                                    <TextBlock Text="{x:Bind ResetText}" Style="{StaticResource HakariCaptionText}" />
                                                    <TextBlock Text="{x:Bind PaceText}" HorizontalAlignment="Right"
                                                        Style="{StaticResource HakariCaptionText}" />
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <!-- Money: a 2 × 2 grid of equal tiles, so nothing is clipped -->
            <Grid x:Name="StatGrid" ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
            </Grid>

            <!-- Burn rate -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Text Key=flyout.burnRate}" Style="{StaticResource HakariLabelText}"
                    VerticalAlignment="Center" />
                <!-- Spending per hour over the last twelve hours, newest on the right -->
                <Polyline x:Name="BurnSpark" Grid.Column="1" Width="120" Height="22" HorizontalAlignment="Right"
                    Stroke="{ThemeResource HakariAccentBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                <TextBlock x:Name="BurnText" Grid.Column="2" FontSize="14" FontWeight="SemiBold"
                    VerticalAlignment="Center" Foreground="{ThemeResource HakariInkBrush}" />
            </Grid>

            <!-- Sources -->
            <ItemsControl x:Name="SourceList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:SourceRow">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8"
                                Fill="{x:Bind local:FlyoutBrushes.ForSource(IsRecent)}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource HakariLabelText}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Detail}" Style="{StaticResource HakariCaptionText}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Footer -->
        <Grid x:Name="Footer" Grid.Row="1" Padding="16,10" ColumnSpacing="8" Background="{ThemeResource HakariTileBrush}"
            BorderBrush="{ThemeResource HakariLineBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{l:Text Key=flyout.dashboard}" Style="{StaticResource HakariPrimaryButton}"
                    Click="OnDashboardClicked" />
                <Button Content="{l:Text Key=flyout.settings}" Style="{StaticResource HakariButton}" Click="OnSettingsClicked" />
            </StackPanel>
            <Button Grid.Column="2" Content="{l:Text Key=flyout.close}" Style="{StaticResource HakariSubtleButton}"
                Click="OnCloseClicked" />
        </Grid>
    </Grid>
</Window>
