<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Hakari.Surfaces</RootNamespace>
    <AssemblyName>Hakari.Surfaces</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\Hakari.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged for development; the MSIX package wraps both executables later -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableMsixTooling>false</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hakari.Core\Hakari.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\data\pricing.json" Link="pricing.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\Hakari.ico" Link="Hakari.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\promptpay.png" Link="promptpay.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\assets\promptpay.png')" />
  </ItemGroup>
  <!-- An unpackaged WinUI publish leaves out the compiled XAML and the resource index, and the
       app cannot start without them; they are copied from the build output. -->
  <Target Name="CopyXamlToPublish" AfterTargets="Publish">
    <ItemGroup>
      <CompiledXaml Include="$(OutDir)**\*.xbf;$(OutDir)$(AssemblyName).pri"
        Exclude="$(OutDir)publish\**" />
    </ItemGroup>
    <Copy SourceFiles="@(CompiledXaml)"
      DestinationFiles="@(CompiledXaml->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
