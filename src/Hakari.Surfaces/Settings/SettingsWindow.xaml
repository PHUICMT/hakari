<Window
    x:Class="Hakari.Surfaces.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Hakari.Surfaces.Controls"
    xmlns:l="using:Hakari.Surfaces.Localization">

    <Grid x:Name="Root" Background="{ThemeResource HakariSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: dragging works anywhere on it; the caption buttons stay the system's -->
        <Grid x:Name="TitleBar" Padding="16,0" ColumnSpacing="10" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="秤" FontFamily="{StaticResource HakariBrandFont}" FontSize="18"
                FontWeight="Bold" Foreground="{ThemeResource HakariAccentBrush}"
                VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{l:Text Key=settings.windowTitle}" FontSize="12.5"
                Foreground="{ThemeResource HakariInkMutedBrush}" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" IsTabStop="True"
            HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Sections" MaxWidth="720" Padding="24,0,24,28">

                <!-- Taskbar layout, with the live preview on top -->
                <StackPanel>
                    <TextBlock Text="{l:Text Key=settings.taskbar}" Style="{StaticResource HakariSectionText}" />
                    <Border Style="{StaticResource HakariCard}">
                        <StackPanel>
                            <StackPanel Padding="16" Spacing="8" CornerRadius="8,8,0,0"
                                Background="{ThemeResource HakariGroundBrush}">
                                <TextBlock Text="{l:Text Key=settings.preview}" Style="{StaticResource HakariCaptionText}" />
                                <!-- One preview block per widget block; built in code -->
                                <StackPanel x:Name="PreviewRow" Orientation="Horizontal" Spacing="6" />
                            </StackPanel>
                            <controls:SettingRow Glyph="&#xE716;" Title="{l:Text Key=settings.accountsMode}"
                                Description="{l:Text Key=settings.accountsMode.description}">
                                <controls:HakariSegmented>
                                    <controls:HakariSegment x:Name="ModeTogether" GroupName="AccountsMode"
                                        Content="{l:Text Key=settings.accountsMode.together}"
                                        Checked="OnAccountsModeChecked" />
                                    <controls:HakariSegment x:Name="ModeSideBySide" GroupName="AccountsMode"
                                        Content="{l:Text Key=settings.accountsMode.sideBySide}"
                                        Checked="OnAccountsModeChecked" />
                                    <controls:HakariSegment x:Name="ModeTakeTurns" GroupName="AccountsMode"
                                        Content="{l:Text Key=settings.accountsMode.takeTurns}"
                                        Checked="OnAccountsModeChecked" />
                                </controls:HakariSegmented>
                            </controls:SettingRow>
                            <controls:SettingRow x:Name="TurnSpeedRow" Glyph="&#xE916;"
                                Title="{l:Text Key=settings.turnSpeed}">
                                <controls:HakariSegmented>
                                    <controls:HakariSegment x:Name="Turn4" GroupName="TurnSpeed" Tag="4"
                                        Content="4 s" Checked="OnTurnSpeedChecked" />
                                    <controls:HakariSegment x:Name="Turn8" GroupName="TurnSpeed" Tag="8"
                                        Content="8 s" Checked="OnTurnSpeedChecked" />
                                    <controls:HakariSegment x:Name="Turn15" GroupName="TurnSpeed" Tag="15"
                                        Content="15 s" Checked="OnTurnSpeedChecked" />
                                    <controls:HakariSegment x:Name="Turn30" GroupName="TurnSpeed" Tag="30"
                                        Content="30 s" Checked="OnTurnSpeedChecked" />
                                </controls:HakariSegmented>
                            </controls:SettingRow>
                            <controls:SettingRow x:Name="LayoutTargetRow" Glyph="&#xE77B;"
                                Title="{l:Text Key=settings.layoutFor}"
                                Description="{l:Text Key=settings.layoutFor.description}">
                                <controls:HakariSelect x:Name="LayoutTargetSelect" />
                            </controls:SettingRow>
                            <controls:SettingRow Glyph="&#xE9D9;" Title="{l:Text Key=settings.ring}"
                                Description="{l:Text Key=settings.ring.description}">
                                <controls:HakariSegmented>
                                    <controls:HakariSegment x:Name="RingOff" GroupName="Ring"
                                        Content="{l:Text Key=settings.ring.off}" Checked="OnRingChecked" />
                                    <controls:HakariSegment x:Name="RingSession" GroupName="Ring"
                                        Content="{l:Text Key=settings.ring.session}" Checked="OnRingChecked" />
                                    <controls:HakariSegment x:Name="RingWeekly" GroupName="Ring"
                                        Content="{l:Text Key=settings.ring.weekly}" Checked="OnRingChecked" />
                                    <controls:HakariSegment x:Name="RingPressing" GroupName="Ring"
                                        Content="{l:Text Key=settings.ring.pressing}" Checked="OnRingChecked" />
                                    <controls:HakariSegment x:Name="RingBoth" GroupName="Ring"
                                        Content="{l:Text Key=settings.ring.both}" Checked="OnRingChecked" />
                                </controls:HakariSegmented>
                            </controls:SettingRow>
                            <controls:SettingRow Glyph="&#xE8E4;" Title="{l:Text Key=settings.topLine}">
                                <controls:HakariSelect x:Name="TopSelect" />
                            </controls:SettingRow>
                            <controls:SettingRow Glyph="&#xE8E4;" Title="{l:Text Key=settings.bottomLine}"
                                Description="{l:Text Key=settings.bottomLine.description}">
                                <controls:HakariSelect x:Name="BottomSelect" />
                            </controls:SettingRow>
                            <controls:SettingRow Glyph="&#xE9D2;" Title="{l:Text Key=settings.precision}"
                                Description="{l:Text Key=settings.precision.description}">
                                <controls:HakariSegmented>
                                    <controls:HakariSegment x:Name="Precision0" GroupName="Precision" Tag="0"
                                        Content="93%" Checked="OnPrecisionChecked" />
                                    <controls:HakariSegment x:Name="Precision1" GroupName="Precision" Tag="1"
                                        Content="93.4%" Checked="OnPrecisionChecked" />
                                    <controls:HakariSegment x:Name="Precision2" GroupName="Precision" Tag="2"
                                        Content="93.41%" Checked="OnPrecisionChecked" />
                                </controls:HakariSegmented>
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Sources -->
                <StackPanel>
                    <TextBlock Text="{l:Text Key=settings.sources}" Style="{StaticResource HakariSectionText}" />
                    <Border Style="{StaticResource HakariCard}">
                        <StackPanel>
                            <controls:SettingRow Glyph="&#xE756;" Title="{l:Text Key=settings.wsl}" BorderThickness="0"
                                Description="{l:Text Key=settings.wsl.description}">
                                <controls:HakariSegmented>
                                    <controls:HakariSegment x:Name="WslOff" GroupName="Wsl" Content="{l:Text Key=settings.wsl.off}"
                                        Checked="OnWslChecked" />
                                    <controls:HakariSegment x:Name="WslRunningOnly" GroupName="Wsl"
                                        Content="{l:Text Key=settings.wsl.runningOnly}" Checked="OnWslChecked" />
                                    <controls:HakariSegment x:Name="WslAll" GroupName="Wsl" Content="{l:Text Key=settings.wsl.all}"
                                        Checked="OnWslChecked" />
                                </controls:HakariSegmented>
                            </controls:SettingRow>
                            <controls:SettingRow Glyph="&#xE8B7;" Title="{l:Text Key=settings.folders}"
                                Description="{l:Text Key=settings.folders.description}">
                                <Button Content="{l:Text Key=settings.folders.add}" Style="{StaticResource HakariButton}"
                                    Click="OnAddFolderClicked" />
                            </controls:SettingRow>
                            <StackPanel x:Name="FolderList" />
                            <controls:SettingRow Glyph="&#xE7F4;" Title="{l:Text Key=settings.displays}"
                                Description="{l:Text Key=settings.displays.description}">
                                <controls:HakariSegmented>
                                    <controls:HakariSegment x:Name="DisplaysPrimary" GroupName="Displays"
                                        Content="{l:Text Key=settings.displays.main}" Checked="OnDisplaysChecked" />
                                    <controls:HakariSegment x:Name="DisplaysAll" GroupName="Displays"
                                        Content="{l:Text Key=settings.displays.all}" Checked="OnDisplaysChecked" />
                                    <controls:HakariSegment x:Name="DisplaysChosen" GroupName="Displays"
                                        Content="{l:Text Key=settings.displays.choose}" Checked="OnDisplaysChecked" />
                                </controls:HakariSegmented>
                            </controls:SettingRow>
                            <StackPanel x:Name="DisplayList" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Accounts -->
                <StackPanel>
                    <TextBlock Text="{l:Text Key=settings.accounts}" Style="{StaticResource HakariSectionText}" />
                    <Border Style="{StaticResource HakariCard}">
                        <StackPanel>
                            <controls:SettingRow Glyph="&#xE8CB;" Title="{l:Text Key=settings.accounts.order}"
                                Description="{l:Text Key=settings.accounts.order.description}" BorderThickness="0">
                                <controls:HakariSegmented>
                                    <controls:HakariSegment x:Name="OrderPressing" GroupName="AccountOrder"
                                        Content="{l:Text Key=settings.accounts.order.pressing}"
                                        Checked="OnAccountOrderChecked" />
                                    <controls:HakariSegment x:Name="OrderCustom" GroupName="AccountOrder"
                                        Content="{l:Text Key=settings.accounts.order.custom}"
                                        Checked="OnAccountOrderChecked" />
                                </controls:HakariSegmented>
                            </controls:SettingRow>
                            <StackPanel x:Name="AccountList" BorderThickness="0,1,0,0"
                                BorderBrush="{ThemeResource HakariLineBrush}" />                            <controls:SettingRow Glyph="&#xE72C;" Title="{l:Text Key=settings.renew}"
                                Description="{l:Text Key=settings.renew.description}">
                                <controls:HakariToggle x:Name="RenewSignInToggle" Click="OnRenewSignInClicked" />
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- General -->
                <StackPanel>
                    <TextBlock Text="{l:Text Key=settings.general}" Style="{StaticResource HakariSectionText}" />
                    <Border Style="{StaticResource HakariCard}">
                        <StackPanel>
                            <controls:SettingRow x:Name="StartupRow" Glyph="&#xE7E8;" Title="{l:Text Key=settings.startup}"
                                BorderThickness="0">
                                <controls:HakariToggle x:Name="StartupToggle" Click="OnStartupClicked" />
                            </controls:SettingRow>
                            <!-- Language names are written in their own language, never translated -->
                            <controls:SettingRow Glyph="&#xE8C1;" Title="{l:Text Key=settings.language}">
                                <controls:HakariSegmented>
                                    <controls:HakariSegment x:Name="LanguageSystem" GroupName="Language"
                                        Content="{l:Text Key=settings.language.system}"
                                        Checked="OnLanguageChecked" />
                                    <controls:HakariSegment x:Name="LanguageEnglish" GroupName="Language"
                                        Content="English" Checked="OnLanguageChecked" />
                                    <controls:HakariSegment x:Name="LanguageThai" GroupName="Language"
                                        Content="ไทย" Checked="OnLanguageChecked" />
                                </controls:HakariSegmented>
                            </controls:SettingRow>
                            <controls:SettingRow Glyph="&#xE768;" Title="{l:Text Key=settings.animations}"
                                Description="{l:Text Key=settings.animations.description}">
                                <controls:HakariSegmented>
                                    <controls:HakariSegment x:Name="MotionFollow" GroupName="Motion"
                                        Content="{l:Text Key=settings.animations.follow}" Checked="OnMotionChecked" />
                                    <controls:HakariSegment x:Name="MotionFull" GroupName="Motion"
                                        Content="{l:Text Key=settings.animations.full}" Checked="OnMotionChecked" />
                                    <controls:HakariSegment x:Name="MotionReduced" GroupName="Motion"
                                        Content="{l:Text Key=settings.animations.reduced}" Checked="OnMotionChecked" />
                                    <controls:HakariSegment x:Name="MotionOff" GroupName="Motion"
                                        Content="{l:Text Key=settings.animations.off}" Checked="OnMotionChecked" />
                                </controls:HakariSegmented>
                            </controls:SettingRow>
                            <controls:SettingRow Glyph="&#xE8C7;" Title="{l:Text Key=settings.currency}"
                                Description="{l:Text Key=settings.currency.description}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:HakariSegmented x:Name="CurrencyChoices" />
                                    <TextBox x:Name="OtherCurrencyBox" Width="64" MaxLength="3"
                                        CharacterCasing="Upper" Style="{StaticResource HakariTextBox}"
                                        ToolTipService.ToolTip="{l:Text Key=settings.currency.other}"
                                        KeyDown="OnOtherCurrencyKeyDown" LostFocus="OnOtherCurrencyLostFocus" />
                                </StackPanel>
                            </controls:SettingRow>
                            <controls:SettingRow Glyph="&#xE774;" Title="{l:Text Key=settings.rate}"
                                Description="{l:Text Key=settings.rate.description}">
                                <controls:HakariSegmented>
                                    <controls:HakariSegment x:Name="RateUsageDay" GroupName="Rate"
                                        Content="{l:Text Key=settings.rate.usageDay}" Checked="OnRateChecked" />
                                    <controls:HakariSegment x:Name="RateLatest" GroupName="Rate"
                                        Content="{l:Text Key=settings.rate.latest}" Checked="OnRateChecked" />
                                </controls:HakariSegmented>
                            </controls:SettingRow>
                            <controls:SettingRow Glyph="&#xE769;" Title="{l:Text Key=settings.pause}"
                                Description="{l:Text Key=settings.pause.description}">
                                <controls:HakariToggle x:Name="PauseToggle" Click="OnPauseClicked" />
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- About -->
                <StackPanel>
                    <TextBlock Text="{l:Text Key=settings.about}" Style="{StaticResource HakariSectionText}" />
                    <Border Style="{StaticResource HakariCard}">
                        <StackPanel>
                            <controls:SettingRow x:Name="VersionRow" Glyph="&#xE946;" BorderThickness="0"
                                Description="{l:Text Key=settings.privacy}" />
                            <controls:SettingRow Glyph="&#xEB51;" Title="{l:Text Key=settings.support}"
                                Description="{l:Text Key=settings.support.description}">
                                <Button Content="Ko-fi" Style="{StaticResource HakariPrimaryButton}"
                                    Click="OnSupportClicked" />
                            </controls:SettingRow>
                            <controls:SettingRow x:Name="DataFolderRow" Glyph="&#xE8A5;" Title="{l:Text Key=settings.dataFolder}">
                                <Button Content="{l:Text Key=settings.dataFolder.open}" Style="{StaticResource HakariButton}"
                                    Click="OnOpenDataFolderClicked" />
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
