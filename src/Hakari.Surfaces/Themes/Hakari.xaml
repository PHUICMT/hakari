<!-- Hakari design tokens (docs/design/ui-preview.html) as theme resources, plus custom control
     templates so no default Fluent visuals leak through. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Hakari.Surfaces.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="HakariSurfaceColor">#F8F9FC</Color>
            <Color x:Key="HakariTileColor">#FFFFFF</Color>
            <Color x:Key="HakariLineColor">#E0E3EB</Color>
            <Color x:Key="HakariLineStrongColor">#C9CEDB</Color>
            <Color x:Key="HakariGroundColor">#F2F3F7</Color>
            <Color x:Key="HakariTaskbarColor">#F3F3F3</Color>
            <Color x:Key="HakariChart1Color">#B9C8EA</Color>
            <Color x:Key="HakariChart2Color">#6F8FD0</Color>
            <Color x:Key="HakariChart3Color">#2F4C8C</Color>
            <Color x:Key="HakariChart4Color">#8A6FB8</Color>
            <Color x:Key="HakariChart5Color">#3E9A8F</Color>
            <Color x:Key="HakariHeat0Color">#ECEFF5</Color>
            <Color x:Key="HakariHeat1Color">#C9D4EE</Color>
            <Color x:Key="HakariHeat2Color">#8FA6DC</Color>
            <Color x:Key="HakariHeat3Color">#4F6FB6</Color>
            <Color x:Key="HakariHeat4Color">#2F4C8C</Color>
            <Color x:Key="HakariAccentSoftColor">#E5EBF7</Color>
            <Color x:Key="HakariOkSoftColor">#E2F3EA</Color>
            <Color x:Key="HakariWarnSoftColor">#FBEFD9</Color>
            <Color x:Key="HakariCriticalSoftColor">#FBE3E1</Color>
            <Color x:Key="HakariInkColor">#1A1E29</Color>
            <Color x:Key="HakariInkMutedColor">#4A5164</Color>
            <Color x:Key="HakariInkFaintColor">#7B8296</Color>
            <Color x:Key="HakariAccentColor">#2F4C8C</Color>
            <Color x:Key="HakariAccentStrongColor">#233A6E</Color>
            <Color x:Key="HakariOnAccentColor">#FFFFFF</Color>
            <Color x:Key="HakariOkColor">#1D7A4C</Color>
            <Color x:Key="HakariWarnColor">#A96500</Color>
            <Color x:Key="HakariCriticalColor">#C0322B</Color>
            <Color x:Key="HakariHoverColor">#0D000000</Color>
            <Color x:Key="HakariPressedColor">#1A000000</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="HakariSurfaceColor">#1D212B</Color>
            <Color x:Key="HakariTileColor">#171A22</Color>
            <Color x:Key="HakariLineColor">#2A2F3B</Color>
            <Color x:Key="HakariLineStrongColor">#3A4050</Color>
            <Color x:Key="HakariGroundColor">#0F1116</Color>
            <Color x:Key="HakariTaskbarColor">#1C1C1C</Color>
            <Color x:Key="HakariChart1Color">#39507F</Color>
            <Color x:Key="HakariChart2Color">#5F7FC6</Color>
            <Color x:Key="HakariChart3Color">#93ACEA</Color>
            <Color x:Key="HakariChart4Color">#B49BE0</Color>
            <Color x:Key="HakariChart5Color">#5CC0B3</Color>
            <Color x:Key="HakariHeat0Color">#1E222C</Color>
            <Color x:Key="HakariHeat1Color">#25345A</Color>
            <Color x:Key="HakariHeat2Color">#34508F</Color>
            <Color x:Key="HakariHeat3Color">#5F80CC</Color>
            <Color x:Key="HakariHeat4Color">#A3B9EF</Color>
            <Color x:Key="HakariAccentSoftColor">#1F2A45</Color>
            <Color x:Key="HakariOkSoftColor">#12291E</Color>
            <Color x:Key="HakariWarnSoftColor">#2F2410</Color>
            <Color x:Key="HakariCriticalSoftColor">#34161A</Color>
            <Color x:Key="HakariInkColor">#E8EBF2</Color>
            <Color x:Key="HakariInkMutedColor">#A9B0C1</Color>
            <Color x:Key="HakariInkFaintColor">#7A8297</Color>
            <Color x:Key="HakariAccentColor">#93ACEA</Color>
            <Color x:Key="HakariAccentStrongColor">#B4C6F1</Color>
            <Color x:Key="HakariOnAccentColor">#0F1626</Color>
            <Color x:Key="HakariOkColor">#4CC38A</Color>
            <Color x:Key="HakariWarnColor">#F0A43A</Color>
            <Color x:Key="HakariCriticalColor">#FF6D63</Color>
            <Color x:Key="HakariHoverColor">#12FFFFFF</Color>
            <Color x:Key="HakariPressedColor">#20FFFFFF</Color>
        </ResourceDictionary>
        <!-- High contrast: every color comes from the user's own contrast theme, and tones
             are told by words and marks, never by color alone -->
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="HakariSurfaceColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="HakariTileColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="HakariLineColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="HakariLineStrongColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="HakariGroundColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="HakariTaskbarColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="HakariChart1Color" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="HakariChart2Color" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="HakariChart3Color" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="HakariChart4Color" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="HakariChart5Color" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="HakariHeat0Color" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="HakariHeat1Color" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="HakariHeat2Color" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="HakariHeat3Color" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="HakariHeat4Color" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="HakariAccentSoftColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="HakariOkSoftColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="HakariWarnSoftColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="HakariCriticalSoftColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="HakariInkColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="HakariInkMutedColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="HakariInkFaintColor" ResourceKey="SystemColorGrayTextColor" />
            <StaticResource x:Key="HakariAccentColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="HakariAccentStrongColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="HakariOnAccentColor" ResourceKey="SystemColorHighlightTextColor" />
            <StaticResource x:Key="HakariOkColor" ResourceKey="SystemColorHotlightColor" />
            <StaticResource x:Key="HakariWarnColor" ResourceKey="SystemColorHotlightColor" />
            <StaticResource x:Key="HakariCriticalColor" ResourceKey="SystemColorHotlightColor" />
            <StaticResource x:Key="HakariHoverColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="HakariPressedColor" ResourceKey="SystemColorHighlightColor" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Mostly opaque: acrylic only tints the edges, so what is behind never hurts legibility -->
    <SolidColorBrush x:Key="HakariSurfaceBrush" Color="{ThemeResource HakariSurfaceColor}" Opacity="0.9" />
    <SolidColorBrush x:Key="HakariTileBrush" Color="{ThemeResource HakariTileColor}" />
    <!-- The raised surface, fully opaque: a hover fill that eases from the tile without
         letting the page show through halfway -->
    <SolidColorBrush x:Key="HakariRaisedBrush" Color="{ThemeResource HakariSurfaceColor}" />
    <SolidColorBrush x:Key="HakariLineBrush" Color="{ThemeResource HakariLineColor}" />
    <SolidColorBrush x:Key="HakariLineStrongBrush" Color="{ThemeResource HakariLineStrongColor}" />
    <SolidColorBrush x:Key="HakariGroundBrush" Color="{ThemeResource HakariGroundColor}" />
    <SolidColorBrush x:Key="HakariTaskbarBrush" Color="{ThemeResource HakariTaskbarColor}" />
    <SolidColorBrush x:Key="HakariChart1Brush" Color="{ThemeResource HakariChart1Color}" />
    <SolidColorBrush x:Key="HakariChart2Brush" Color="{ThemeResource HakariChart2Color}" />
    <SolidColorBrush x:Key="HakariChart3Brush" Color="{ThemeResource HakariChart3Color}" />
    <SolidColorBrush x:Key="HakariChart4Brush" Color="{ThemeResource HakariChart4Color}" />
    <SolidColorBrush x:Key="HakariChart5Brush" Color="{ThemeResource HakariChart5Color}" />
    <SolidColorBrush x:Key="HakariHeat0Brush" Color="{ThemeResource HakariHeat0Color}" />
    <SolidColorBrush x:Key="HakariHeat1Brush" Color="{ThemeResource HakariHeat1Color}" />
    <SolidColorBrush x:Key="HakariHeat2Brush" Color="{ThemeResource HakariHeat2Color}" />
    <SolidColorBrush x:Key="HakariHeat3Brush" Color="{ThemeResource HakariHeat3Color}" />
    <SolidColorBrush x:Key="HakariHeat4Brush" Color="{ThemeResource HakariHeat4Color}" />
    <SolidColorBrush x:Key="HakariAccentSoftBrush" Color="{ThemeResource HakariAccentSoftColor}" />
    <SolidColorBrush x:Key="HakariOkSoftBrush" Color="{ThemeResource HakariOkSoftColor}" />
    <SolidColorBrush x:Key="HakariWarnSoftBrush" Color="{ThemeResource HakariWarnSoftColor}" />
    <SolidColorBrush x:Key="HakariCriticalSoftBrush" Color="{ThemeResource HakariCriticalSoftColor}" />
    <SolidColorBrush x:Key="HakariInkBrush" Color="{ThemeResource HakariInkColor}" />
    <SolidColorBrush x:Key="HakariInkMutedBrush" Color="{ThemeResource HakariInkMutedColor}" />
    <SolidColorBrush x:Key="HakariInkFaintBrush" Color="{ThemeResource HakariInkFaintColor}" />
    <SolidColorBrush x:Key="HakariAccentBrush" Color="{ThemeResource HakariAccentColor}" />
    <SolidColorBrush x:Key="HakariAccentStrongBrush" Color="{ThemeResource HakariAccentStrongColor}" />
    <SolidColorBrush x:Key="HakariOnAccentBrush" Color="{ThemeResource HakariOnAccentColor}" />
    <SolidColorBrush x:Key="HakariOkBrush" Color="{ThemeResource HakariOkColor}" />
    <SolidColorBrush x:Key="HakariWarnBrush" Color="{ThemeResource HakariWarnColor}" />
    <SolidColorBrush x:Key="HakariCriticalBrush" Color="{ThemeResource HakariCriticalColor}" />
    <SolidColorBrush x:Key="HakariHoverBrush" Color="{ThemeResource HakariHoverColor}" />
    <SolidColorBrush x:Key="HakariPressedBrush" Color="{ThemeResource HakariPressedColor}" />

    <FontFamily x:Key="HakariBrandFont">Yu Mincho, MS Mincho, Segoe UI</FontFamily>
    <CornerRadius x:Key="HakariControlRadius">4</CornerRadius>
    <CornerRadius x:Key="HakariOverlayRadius">8</CornerRadius>

    <Style x:Key="HakariCaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource HakariInkFaintBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="HakariLabelText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{ThemeResource HakariInkMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="HakariValueText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource HakariInkBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- One button template for every button: hover and press fills, press scale, no Fluent chrome -->
    <Style x:Key="HakariButton" TargetType="Button">
        <Setter Property="Foreground" Value="{ThemeResource HakariInkBrush}" />
        <Setter Property="Background" Value="{ThemeResource HakariTileBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HakariLineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="{StaticResource HakariControlRadius}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border x:Name="StateFill" Background="Transparent"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="Center"
                            Foreground="{TemplateBinding Foreground}"
                            Content="{TemplateBinding Content}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="StateFill.Background" Value="{ThemeResource HakariHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="StateFill.Background" Value="{ThemeResource HakariPressedBrush}" />
                                        <Setter Target="PressScale.ScaleX" Value="0.97" />
                                        <Setter Target="PressScale.ScaleY" Value="0.97" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HakariPrimaryButton" TargetType="Button" BasedOn="{StaticResource HakariButton}">
        <Setter Property="Background" Value="{ThemeResource HakariAccentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HakariAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource HakariOnAccentBrush}" />
    </Style>

    <Style x:Key="HakariSubtleButton" TargetType="Button" BasedOn="{StaticResource HakariButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource HakariInkMutedBrush}" />
        <Setter Property="Padding" Value="8,5" />
    </Style>

    <FontFamily x:Key="HakariIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="HakariMonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- Drop-down list: a raised card with full-width rows -->
    <Style x:Key="HakariListPresenter" TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource HakariTileBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HakariLineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource HakariOverlayRadius}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="IsDefaultShadowEnabled" Value="True" />
    </Style>

    <!-- A full-width header inside a card: fills on hover and press but never shrinks, which
         would pull it away from the card's edges and show a dark rim -->
    <Style x:Key="HakariCardHeaderButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border x:Name="StateFill" Background="Transparent"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="Center" Content="{TemplateBinding Content}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.12" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="StateFill.Background" Value="{ThemeResource HakariHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="StateFill.Background" Value="{ThemeResource HakariPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "Add another": a dashed outline that fills on hover; faded when there is no room -->
    <Style x:Key="HakariDashedButton" TargetType="Button">
        <Setter Property="Foreground" Value="{ThemeResource HakariInkMutedBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border x:Name="StateFill" Background="Transparent"
                            CornerRadius="{StaticResource HakariControlRadius}" />
                        <Rectangle Stroke="{ThemeResource HakariLineStrongBrush}" StrokeThickness="1"
                            StrokeDashArray="4,3" RadiusX="4" RadiusY="4" />
                        <ContentPresenter x:Name="Presenter" Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="Center" Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.12" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="StateFill.Background" Value="{ThemeResource HakariHoverBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource HakariInkBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="StateFill.Background" Value="{ThemeResource HakariPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dashboard navigation: icon and label; the chosen page gets a raised fill and an
         accent bar on the left that grows in -->
    <Style x:Key="HakariNavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{ThemeResource HakariInkMutedBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="Transparent" CornerRadius="{StaticResource HakariControlRadius}">
                        <Border x:Name="StateFill" Background="Transparent"
                            CornerRadius="{StaticResource HakariControlRadius}" />
                        <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="1.5"
                            HorizontalAlignment="Left" Background="{ThemeResource HakariAccentBrush}"
                            RenderTransformOrigin="0.5,0.5" Opacity="0">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="IndicatorScale" ScaleY="0.3" />
                            </Border.RenderTransform>
                        </Border>
                        <ContentPresenter x:Name="Label" Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                            Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding Content}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="StateFill.Background" Value="{ThemeResource HakariHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="StateFill.Background" Value="{ThemeResource HakariPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity"
                                            To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="IndicatorScale" Storyboard.TargetProperty="ScaleY"
                                            To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <ExponentialEase EasingMode="EaseOut" Exponent="6" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource HakariTileBrush}" />
                                        <Setter Target="Label.Foreground" Value="{ThemeResource HakariInkBrush}" />
                                        <Setter Target="Label.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HakariListItemButton" TargetType="Button" BasedOn="{StaticResource HakariButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="10,7" />
    </Style>

    <Style x:Key="HakariSectionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource HakariInkBrush}" />
        <Setter Property="Margin" Value="4,16,0,8" />
    </Style>

    <Style x:Key="HakariCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource HakariTileBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HakariLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource HakariOverlayRadius}" />
    </Style>

    <!-- Settings row: icon, title and description, control on the right. Rows after the
         first in a card draw the divider above themselves. -->
    <Style TargetType="controls:SettingRow">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="BorderBrush" Value="{ThemeResource HakariLineBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingRow">
                    <Grid Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}"
                        Background="{TemplateBinding Background}"
                        ColumnSpacing="12" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{TemplateBinding Glyph}" FontSize="16"
                            FontFamily="{StaticResource HakariIconFont}"
                            Foreground="{ThemeResource HakariInkMutedBrush}" HorizontalAlignment="Left" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{TemplateBinding Title}" FontSize="13.5" TextWrapping="Wrap"
                                Foreground="{ThemeResource HakariInkBrush}" />
                            <TextBlock Text="{TemplateBinding Description}" FontSize="12" TextWrapping="Wrap"
                                Foreground="{ThemeResource HakariInkFaintBrush}"
                                Visibility="{TemplateBinding DescriptionVisibility}" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="2" VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Switch: 40×20 track, 12 px thumb. The slide itself is animated by HakariToggle. -->
    <Style TargetType="controls:HakariToggle">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:HakariToggle">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                            BorderBrush="{ThemeResource HakariLineStrongBrush}"
                            Background="{ThemeResource HakariTileBrush}" />
                        <Border x:Name="StateFill" CornerRadius="10" Background="Transparent" />
                        <Ellipse x:Name="Thumb" Width="12" Height="12" Margin="4,0,0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Fill="{ThemeResource HakariInkMutedBrush}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="StateFill.Background" Value="{ThemeResource HakariHoverBrush}" />
                                        <Setter Target="Thumb.Fill" Value="{ThemeResource HakariInkBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="StateFill.Background" Value="{ThemeResource HakariPressedBrush}" />
                                        <Setter Target="Thumb.Fill" Value="{ThemeResource HakariInkBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Track.Background" Value="{ThemeResource HakariAccentBrush}" />
                                        <Setter Target="Track.BorderBrush" Value="{ThemeResource HakariAccentBrush}" />
                                        <Setter Target="Thumb.Fill" Value="{ThemeResource HakariOnAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Track.Background" Value="{ThemeResource HakariAccentStrongBrush}" />
                                        <Setter Target="Track.BorderBrush" Value="{ThemeResource HakariAccentStrongBrush}" />
                                        <Setter Target="Thumb.Fill" Value="{ThemeResource HakariOnAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Track.Background" Value="{ThemeResource HakariAccentStrongBrush}" />
                                        <Setter Target="Track.BorderBrush" Value="{ThemeResource HakariAccentStrongBrush}" />
                                        <Setter Target="Thumb.Fill" Value="{ThemeResource HakariOnAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Track.Background" Value="{ThemeResource HakariAccentBrush}" />
                                        <Setter Target="Track.BorderBrush" Value="{ThemeResource HakariAccentBrush}" />
                                        <Setter Target="Thumb.Fill" Value="{ThemeResource HakariOnAccentBrush}" />
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented control: a framed row of HakariSegment choices over a sliding indicator -->
    <Style TargetType="controls:HakariSegmented">
        <Setter Property="ColumnSpacing" Value="2" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="CornerRadius" Value="{StaticResource HakariControlRadius}" />
        <Setter Property="Background" Value="{ThemeResource HakariGroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HakariLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="controls:HakariSegment">
        <Setter Property="Foreground" Value="{ThemeResource HakariInkMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:HakariSegment">
                    <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="StateFill" CornerRadius="3" Background="Transparent" />
                        <ContentPresenter x:Name="Text" Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                            Content="{TemplateBinding Content}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="StateFill.Background" Value="{ThemeResource HakariHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="StateFill.Background" Value="{ThemeResource HakariPressedBrush}" />
                                        <Setter Target="PressScale.ScaleX" Value="0.95" />
                                        <Setter Target="PressScale.ScaleY" Value="0.95" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Text.Foreground" Value="{ThemeResource HakariOnAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text field: a quiet frame that gains an accent underline while focused -->
    <Style x:Key="HakariTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{ThemeResource HakariInkBrush}" />
        <Setter Property="Background" Value="{ThemeResource HakariTileBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HakariLineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource HakariAccentBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource HakariControlRadius}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid x:Name="Root" MinHeight="{TemplateBinding MinHeight}">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border x:Name="FocusLine" Height="2" VerticalAlignment="Bottom" Opacity="0"
                            CornerRadius="0,0,4,4" Background="{ThemeResource HakariAccentBrush}" />
                        <ScrollViewer x:Name="ContentElement" Padding="{TemplateBinding Padding}"
                            VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"
                            HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                            ZoomMode="Disabled" IsTabStop="False" />
                        <!-- The hint while empty; TextBox shows and hides this part by its name -->
                        <ContentControl x:Name="PlaceholderTextContentPresenter"
                            Padding="{TemplateBinding Padding}" VerticalAlignment="Center"
                            Content="{TemplateBinding PlaceholderText}" IsHitTestVisible="False"
                            IsTabStop="False" Foreground="{ThemeResource HakariInkFaintBrush}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="Focused" GeneratedDuration="0:0:0.12" />
                                    <VisualTransition From="Focused" GeneratedDuration="0:0:0.12" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Frame.BorderBrush" Value="{ThemeResource HakariInkFaintBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusLine"
                                            Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
